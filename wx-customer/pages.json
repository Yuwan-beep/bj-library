{
	"easycom": {
		"^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/register/register",
			"style": {
				"navigationBarTitleText": "注册账号",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/home/home",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/scan/borrow",
			"style": {
				"navigationBarTitleText": "扫码借书",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/scan/return",
			"style": {
				"navigationBarTitleText": "扫码还书",
				"enablePullDownRefresh": false
			}
		},
		{
			"path" : "pages/notice/notice",
			"style" : 
			{
				"navigationBarTitleText" : "通知列表",
				"enablePullDownRefresh" : false
			}
		},
		{
			"path" : "pages/notice/noticeInfo",
			"style" : 
			{
				"navigationBarTitleText" : "通知详情",
				"enablePullDownRefresh" : false
			}
		},
		{
			"path" : "pages/advice/advice",
			"style" : 
			{
				"navigationBarTitleText" : "建议列表",
				"enablePullDownRefresh" : false
			}
		},
		{
			"path" : "pages/advice/adviceInfo",
			"style" : 
			{
				"navigationBarTitleText" : "建议详情",
				"enablePullDownRefresh" : false
			}
		},
		{
			"path" : "pages/advice/addAdvice",
			"style" : 
			{
				"navigationBarTitleText" : "提出建议",
				"enablePullDownRefresh" : false
			}
		},
		{
			"path" : "pages/lecture/lecture",
			"style" : 
			{
				"navigationBarTitleText" : "座谈会",
				"enablePullDownRefresh" : false
			}
		},
		{
			"path" : "pages/ai/ai",
			"style" : 
			{
				"navigationBarTitleText" : "AI搜索",
				"enablePullDownRefresh" : false
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}