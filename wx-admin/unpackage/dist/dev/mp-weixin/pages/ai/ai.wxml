<view class="ai-container"><scroll-view class="messages-container" scroll-y="{{true}}" scroll-top="{{scrollTop}}"><block wx:for="{{$root.l0}}" wx:for-item="message" wx:for-index="index" wx:key="index"><view class="{{['message',message.$orig.role==='user'?'user-message':'ai-message']}}"><view class="message-content"><block wx:if="{{message.$orig.role==='assistant'}}"><view class="ai-avatar"><image src="/static/ai-avatar.jpg" mode="aspectFill"></image></view></block><view class="text-content"><block wx:if="{{message.$orig.role==='assistant'}}"><view class="ai-name">AI 助手</view></block><block wx:if="{{message.$orig.role==='assistant'&&message.$orig.reasoning}}"><view class="reasoning-section"><view class="reasoning-header">思考过程：</view><view class="reasoning-content">{{message.$orig.reasoning}}</view></view><view class="content-section"><view class="content-header">回答：</view><view class="message-text"><rich-text nodes="{{message.m0}}"></rich-text></view></view></block><block wx:else><view class="message-text"><rich-text nodes="{{message.m1}}"></rich-text></view></block></view></view></view></block></scroll-view><view class="input-container"><view class="input-wrapper"><view class="deep-thinking-switch"><switch checked="{{isDeepThinking}}" scale="0.8" data-event-opts="{{[['change',[['e0',['$event']]]]]}}" bindchange="__e"></switch><text class="switch-label">深度思考</text></view><input class="input-box" type="text" placeholder="请输入您的问题" disabled="{{isLoading}}" data-event-opts="{{[['confirm',[['e1',['$event']]]],['input',[['__set_model',['','question','$event',[]]]]]]}}" value="{{question}}" bindconfirm="__e" bindinput="__e"/><button data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="{{['action-button',isLoading?'stop-button':'send-button']}}" bindtap="__e">{{''+(isLoading?'停止':'发送')+''}}</button></view></view></view>