<view class="data-v-1db32b26"><block wx:if="{{!ISBN}}"><view data-event-opts="{{[['tap',[['scan',['$event']]]]]}}" class="icon-container data-v-1db32b26" bindtap="__e"><view class="icon data-v-1db32b26"><u-icon vue-id="ce9a8ac0-1" name="scan" size="150" class="data-v-1db32b26" bind:__l="__l"></u-icon></view></view></block><block wx:if="{{ISBN&&!bookData}}"><view style="margin-top:100rpx;" class="data-v-1db32b26"><u-loading-icon vue-id="ce9a8ac0-2" text="加载中" textSize="50" size="100" class="data-v-1db32b26" bind:__l="__l"></u-loading-icon></view></block><block wx:if="{{ISBN&&bookData}}"><view class="data-container data-v-1db32b26"><image src="{{bookData.pictures}}" class="data-v-1db32b26"></image><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">书名</text><text class="content data-v-1db32b26">{{''+bookData.bookName+''}}</text></view><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">作者</text><text class="content data-v-1db32b26">{{''+bookData.author+''}}</text></view><block wx:if="{{bookData.bookDesc}}"><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">摘要</text><text class="content data-v-1db32b26">{{''+bookData.bookDesc+''}}</text></view></block><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">出版社</text><text class="content data-v-1db32b26">{{''+bookData.press+''}}</text></view><block wx:if="{{bookData.pressDate}}"><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">出版时间</text><text class="content data-v-1db32b26">{{''+bookData.pressDate+''}}</text></view></block><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">ISBN</text><text class="content data-v-1db32b26">{{''+bookData.isbn+''}}</text></view><view class="block data-v-1db32b26"><text class="title data-v-1db32b26">中图法分类</text><block wx:if="{{bookData.clcCode}}"><text class="content data-v-1db32b26">{{''+bookData.clcCode+''}}</text></block><block wx:if="{{!bookData.clcCode}}"><text class